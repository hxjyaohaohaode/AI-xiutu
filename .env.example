# Copy to .env. This file contains no working credentials.
NODE_ENV=development
PORT=3001
WEB_PORT=5173
HOST=127.0.0.1
DATABASE_URL=postgresql://xiutu:replace-with-your-local-password@127.0.0.1:5432/xiutu
TEST_DATABASE_URL=postgresql://xiutu:replace-with-your-test-password@127.0.0.1:5432/xiutu_test
DB_POOL_MAX=10
SESSION_SECRET=
# npm run dev derives the localhost origins from WEB_PORT. Set exact origins
# for other hostnames, separate processes, or production.
# APP_ORIGIN=https://photos.example.com
COOKIE_SECURE=false
# 0 for a directly exposed API. Only use 1 when API is reachable solely through your Caddy proxy.
TRUST_PROXY_HOPS=0
STORAGE_DIR=.data/private
MAX_UPLOAD_BYTES=20971520
MAX_IMAGE_PIXELS=40000000

# Trusted server-side provisioning; set only for npm run admin:create.
BOOTSTRAP_ADMIN_PHONE=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=

# Alibaba Cloud PNVS is selected for new deployments from this example.
SMS_PROVIDER=alibaba-pnvs
# Alibaba Cloud SMS Authentication (PNVS): use your account's approved gifted sign and templates.
# Use a server-side RAM credential scoped to dypns:SendSmsVerifyCode.
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
ALIBABA_CLOUD_SECURITY_TOKEN=
ALIBABA_SMS_SIGN_NAME=
ALIBABA_SMS_TEMPLATE_REGISTER=100001
ALIBABA_SMS_TEMPLATE_LOGIN=100001
ALIBABA_SMS_TEMPLATE_RESET=100003

# Optional original WeChat appreciation PNG. Serve only to signed-in accounts.
# Local: .data/support/wechat-appreciation.png. Compose: /app/.data/support/wechat-appreciation.png.
SUPPORT_QR_FILE=

# Tencent SMS API: approved signature/templates and the correct region are required.
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_SMS_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_REGISTER=
TENCENT_SMS_TEMPLATE_LOGIN=
TENCENT_SMS_TEMPLATE_RESET=
TENCENT_SMS_REGION=ap-guangzhou
# false: template parameters are [code, minutes]; true: [code]. Match your approved template.
TENCENT_SMS_CODE_ONLY=false

# Tencent is the default. Set openai to use the configured OpenAI project for text and image moderation.
AI_MODERATION_PROVIDER=tencent
# Text and image moderation use distinct, approved Tencent policies.
TENCENT_MODERATION_BIZ_TYPE=
TENCENT_IMAGE_MODERATION_BIZ_TYPE=
TENCENT_MODERATION_REGION=ap-guangzhou

# Explicitly enable each capability after setting up real accounts and moderation.
# Also configure the exact model IDs/operations and integer service-point prices in Operations.
# Keys from personal ChatGPT/Gemini subscriptions are not API credentials.
AI_PLAN_ENABLED=false
AI_TEXT_ENABLED=false
AI_IMAGE_ENABLED=false
AI_SPEECH_ENABLED=false
DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Use the official Beijing business-space URL if required for your Alibaba account.
QWEN_ASR_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Comma-separated Qwen3 ASR model IDs confirmed in your own API account; empty disables ASR.
QWEN_ASR_MODELS=
ARK_API_KEY=
# JSON array of actual model/endpoint IDs and audited adapter profiles. Empty disables image generation.
# Example shape only (the ID is NOT a working model): [{"id":"your-enabled-model-id","profile":"seedream-5-flash"}]
ARK_IMAGE_MODELS_JSON=[]
# OpenAI Images uses fixed api.openai.com HTTPS endpoints, never a browser-supplied URL.
# Requires a permitted account/region, approved model access, configured moderation and AI_IMAGE_ENABLED=true.
# This application does not provision credentials or assume a ChatGPT subscription grants API access.
OPENAI_IMAGE_ENABLED=false
OPENAI_API_KEY=
# Comma-separated exact audited IDs; empty disables OpenAI images. See multimodal capability matrix.
OPENAI_IMAGE_MODELS=
# Optional model allowlist for the existing recorded voice-to-text workflow.
OPENAI_TRANSCRIPTION_MODELS=
# Enables explicitly configured OpenAI speech, audio chat, search, embeddings and audio translation tasks.
OPENAI_SPECIALIST_ENABLED=false
OPENAI_IMAGE_PARTIALS_ENABLED=false
OPENAI_IMAGE_SVG_ENABLED=false
OPENAI_IMAGE_GIF_ENABLED=false
# Set supported authors for accounts with SVG author selection. Leave empty for provider-managed authoring.
OPENAI_IMAGE_SVG_AUTHORS=
OPENAI_MODERATION_MODEL=omni-moderation-latest
# Per-request budgets apply in addition to each model profile and Operations maxOutputs.
OPENAI_IMAGE_MAX_OUTPUTS=4
OPENAI_IMAGE_MAX_REFERENCES=4
OPENAI_IMAGE_MAX_TOTAL_PIXELS=16777216
OPENAI_IMAGE_MAX_TOTAL_BYTES=28000000
AI_DAILY_JOB_LIMIT=100
# Intersected with each provider profile and operation catalog; never upscales a provider response.
AI_IMAGE_MAX_PIXELS=16777216
AI_JOURNAL_DIR=.data/ai-dispatch-journal

# Assistant/voice need the same real text+image moderation and OPENAI_API_KEY.
# Enable audited model profiles separately in Operations → 实时协作模型.
AI_ASSISTANT_ENABLED=false
AI_VOICE_ENABLED=false
# Optional trusted HTTP CONNECT egress for Responses, Live, Realtime and translation WebSockets.
# SOCKS/SS subscriptions require your separately configured local HTTP bridge.
# Responses/Images HTTP use Node's startup environment proxy instead.
ASSISTANT_EGRESS_PROXY=
# Set to 1 only with a trusted, permitted HTTP(S) proxy. Startup must load these
# before Node initializes HTTP: root npm start/worker:ai, npm run dev and Compose do.
# No endpoint or credentials are sent to browsers; no automatic direct fallback.
NODE_USE_ENV_PROXY=0
HTTPS_PROXY=
HTTP_PROXY=
NO_PROXY=localhost,127.0.0.1,::1,db,api,web,dypnsapi.aliyuncs.com
MEDIA_ADVANCED_ENABLED=false
# Optional retained-raster admission limit. Defaults to 200000000, maximum 256000000.
# Native formats and operations still have their own decode and disk budgets.
MEDIA_RASTER_MAX_PIXELS=
# Absolute trusted Python virtualenv interpreter for rawpy/OpenImageIO.
# Leave empty if only installed libvips/static PSD formats are wanted.
MEDIA_PYTHON=

# For docker compose: replace all three values; no defaults are embedded.
POSTGRES_PASSWORD=
# Use a URL-safe random password (hex is suitable) for compose's DATABASE_URL interpolation.
# :80 for local HTTP; use your actual domain for Caddy automatic HTTPS.
APP_DOMAIN=:80
