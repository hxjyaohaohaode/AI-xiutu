{$APP_DOMAIN} {
  encode zstd gzip
  header {
    X-Content-Type-Options nosniff
    Referrer-Policy same-origin
    Permissions-Policy "camera=(), microphone=(self), geolocation=()"
    Content-Security-Policy "default-src 'self'; script-src 'self'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; media-src 'self' blob:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
  }
  handle /v1/* {
    reverse_proxy api:3001
  }
  handle /health {
    reverse_proxy api:3001
  }
  handle {
    root * /srv
    try_files {path} /index.html
    file_server
  }
}
